DEPLOYER=
ARC_MAINNET_RPC_URL=https://rpc.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# No PRIVATE_KEY here on purpose — the deploy scripts sign via forge's
# encrypted keystore (`--account klap-arc-deployer`), never a raw key in an
# env var. Run this once, before deploying, to create it:
#   cast wallet import klap-arc-deployer --interactive
# DEPLOYER above must be that same wallet's address — DeployKlapArc.s.sol
# broadcasts explicitly *as* DEPLOYER and forge itself refuses to proceed if
# the keystore's key doesn't match.
